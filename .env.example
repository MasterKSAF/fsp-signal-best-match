# Generate .env with: node scripts/setup-env.mjs (never commit .env).
POSTGRES_PASSWORD=replace-with-random-64-character-database-password
DATABASE_URL=postgresql://signal:replace-with-random-64-character-database-password@127.0.0.1:55450/signal
PORT=4312
API_PORT=4312
WEB_PORT=4310
HOST=127.0.0.1
DEMO_MODE=true
SIGNAL_WORKSPACE_ENABLED=true
SIGNAL_SKILL_MODULES_ENABLED=true
MAILPIT_URL=http://127.0.0.1:8050
PUBLIC_URL=http://127.0.0.1:4310
NODE_ENV=development
VERIFICATION_TOKEN_SECRET=replace-with-random-64-character-secret-before-sharing
# Optional live SMTP: switch explicitly; credentials belong only in private environment.
MAIL_TRANSPORT=mailpit
# MAIL_FROM=signal@your-domain.example
# SMTP_HOST=smtp.your-provider.example
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# Separate permission for verified real research operators, never demo users.
SIGNAL_RESEARCH_OPERATOR_IDS=

# Ordinary delivery: experiments and external delivery stay OFF.
SIGNAL_ADAPTIVE_EXPERIMENT_ENABLED=false
SIGNAL_CODE_RUNNER_ENABLED=false
SIGNAL_ATS_WORKER_ENABLED=false
SIGNAL_COMPUTATION_RECOVERY_ENABLED=true
SIGNAL_SELECTION_WATCH_SCHEDULER_ENABLED=true
SIGNAL_INVITATIONS_PER_24H=20
EXPOSE_DEMO_VERIFICATION_CODE=false

# Optional native-host integrations; see docs/operations-current.md.
# SIGNAL_PDF_IMAGE=signal-pdf-import:1
# SIGNAL_DOCKER_BIN=docker
# SIGNAL_PASSPORT_ISSUER=https://signal.example.org
# SIGNAL_PASSPORT_SIGNING_KEY_FILE=/absolute/private/path/passport-private.pem
# SIGNAL_ATS_ENCRYPTION_KEY=locally-generated-base64-32-byte-key
# SIGNAL_CODE_RUNNER_IMAGE=signal-code-runner:1

# Local Docker ports; use the same compose project name on every command.
SIGNAL_HTTP_PORT=4450
SIGNAL_DB_PORT=55450
SIGNAL_MAIL_PORT=8050
# SIGNAL_PUBLIC_URL=https://signal.example.org
