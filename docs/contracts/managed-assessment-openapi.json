              },
              "architecture": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 3
              },
              "ownership": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 3
              }
            }
          }
        }
      },
      "ManagedAssessmentTemplate": {
        "type": "object",
        "required": [
          "id",
          "version",
          "programId",
          "programVersion",
          "grade",
          "competency",
          "scenario",
          "slot",
          "variant",
          "status",
          "responseType",
          "critical",
          "targetSeconds",
          "verifiedSkills"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "programId": {
            "type": "string"
          },
          "programVersion": {
            "type": "string"
          },
          "grade": {
            "type": "string"
          },
          "competency": {
            "type": "string"
          },
          "scenario": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "responseType": {
            "type": "string"
          },
          "version": {
            "type": "integer"
          },
          "slot": {
            "type": "integer"
          },
          "variant": {
            "type": "integer"
          },
          "targetSeconds": {
            "type": "integer"
          },
          "critical": {
            "type": "boolean"
          },
          "verifiedSkills": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
